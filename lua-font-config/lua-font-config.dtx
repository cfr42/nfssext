}
\cs_generate_variant:Nn \_@@_set_mathrm:nnnnnn {nnVVVV}
\cs_generate_variant:Nn \_@@_set_mathsf:nnnnn {nnVVV}
\cs_generate_variant:Nn \_@@_set_mathtt:nnnnn {nnVVV}
\cs_new_protected_nopar:Npn \_@@_set_mathrm:n #1 {
  \_@@_set_mathrm:nnVVVV  {} {#1} \mdseries@rm \bfseries@rm \shapedefault
    \itdefault
}
\cs_new_protected_nopar:Npn \_@@_set_mathsf:n #1 {
  \_@@_set_mathsf:nnVVV  {} {#1} \mdseries@sf \bfseries@sf \shapedefault
}
\cs_new_protected_nopar:Npn \_@@_set_mathtt:n #1 {
