% \maketitle
% \begin{abstract}
% An opentype font configuration package for Lua\LaTeXe{}.
% The aim is to provide an alternative to \pkg{fontspec} which is both faster
% and more powerful, by doing as much processing as possible in Lua.
% To avoid loading fonts unnecessarily, the data used is corrected during 
% compilation and the results cached for future use.
%
% \emph{This package is experimental.}
% \end{abstract}
% 
% \section{Requirements}\label{sec:require}
%
% The package requires Lua\LaTeXe.
% It will not work with any other engine or format.
%
% Unicode maths is supported \emph{via} \pkg{lua-unicode-math}.
% It will \textbf{not} work with \pkg{unicode-math}.
%
% \section{Usage}\label{sec:pkg}
%
% \emph{The user interface is currently \textbf{extremely} basic.}
%
% All that is properly supported is the choice of font family for the standard
% families --- i.e.~roman/serif, sans, typewriter/mono and (Unicode) maths 
% (main, script and calligraphic) --- and configuration of additional fonts, 
% again by family.
% In addition to this, scaling and raw feature selection are supported.
% That is, most things are supported in the sense that they are possible, but
% the interface is rudimentary in the extreme.
%
% That said, the automated configuration is quite extensive.
% By default, the package tries to configure font families which are as rich
% as possible, insofar as the fonts support this. 
% This includes
% \begin{itemize}
%   \item multiple widths and shapes, insofar as \textsc{nfss} supports them;
%   \item italic, oblique, upright italic, reverse italic, reverse oblique;
%   \item small-caps, italic small-caps, oblique small-caps\footnote{%
%     This should work whether small-caps are in separate fonts (e.g.~Latin 
%     Modern) or implemented by the \texttt{smcp} feature (e.g.~\TeX{}-Gyre
%     Pagella).};
%   \item optical sizes.
% \end{itemize}
% Of course, this depends on the quality of the data the fonts provide.
% It is not always good or, even, vaguely accurate. 
% If things do not fit, some (currently minimal) effort is made to 
% accommodate them as distinct font families, so they are still available 
% at document level.
%
% At present, this is a bit chaotic and a bit hard to use, as the 
% results are ‘hidden’ from you (in, of course, plain sight).
% Even so, you should typically need to do much less to access the fonts you
% want than you might otherwise expect. 
%
% The advantage of this is that if a font has several widths, you can easily
% adjust the one used for bold by simply redefining the relevant default.
% This is not very user friendly yet, but it is not completely terrible.
% 
%
% Simple usage looks like this:
% \iffalse
%<*verb>
% \fi
\begin{minted}{latex}
  \usepackage{lua-font-config}
  \fontconfig{%
    rm = texgyrepagella,
    sf = texgyreheros,
    tt = texgyrecursor,
    math = texgyrescholamath,
  }
\end{minted}
% \iffalse
%</verb>
% \fi
%
% \DescribeMacro{\fontconfig}\marg{key-val list}\par
% Specify font configuration.
% 
% \subsection{Keys}\label{subsec:keys}
% Top-level keys are described here.
% Keys for use in key-value lists are described in \cref{subsec:keys-cfg}.
%
% \DescribeKey{rm}\val{family name}\par
% \DescribeKey{rm}\val{key-val list}\par
% Specify family to use as the main document font, typically a serif or ‘roman’ family.
%
% Available keys are listed below.
%
% \DescribeKey{sf}\val{family name}\par
% \DescribeKey{sf}\val{key-val list}\par
% Specify family to use as the default sans family, typically a sans-serif.
%
% Available keys are listed below.
%
% \DescribeKey{tt}\val{family name}\par
% \DescribeKey{tt}\val{key-val list}\par
% Specify family to use as the default ‘typewriter’ family, typically monowidth.
%
% Available keys are listed below.
%
% \DescribeKey{fam}\val{family name}\par
% \DescribeKey{fam}\val{key-val list}\par
% Specify an additional text family.
% This will create a macro which can be used to switch to the requested family\footnote{%
%   Sorry: right now you must figure out what this is.%
% }.
%
% Available keys are listed below.
%
% \DescribeKey{math}\val{family name}\par
% \DescribeKey{math}\val{key-val list}\par
% Specify the family to use for typesetting Unicode mathematics.
% This sets the fonts used for symbols, script and calligraphic alphabets.
% It does not change the fonts used to typeset operators, since these are taken from text fonts and configured separately.
%
% Available keys are listed below.
%
% This option uses \pkg{lua-unicode-math}.
% \pkg{unicode-math} is \textbf{not} supported.
% If you wish to use \pkg{unicode-math}, do not use this option.
% Instead, load \pkg{unicode-math} and use \cs{setmathfont} as usual.
%
% \subsection{Keys for specifying font families}\label{subsec:keys-cfg}
%
% All keys described in \cref{subsec:keys} accept either a simple family name,
% as shown in the example above, or a braced key-value list.
% For example,
% \iffalse
%<*verb>
% \fi
\begin{minted}{latex}
  \usepackage{lua-font-config}
  \fontconfig{%
    rm = {%
      name = texgyrepagella, 
      fea  = {script=ltn;+tlig;+pnum},
    },
    sf = {%
      name  = texgyreheros,
      scale = 1.2,
      fea   = {script=cyrl;},
    },
    tt = {%
      name  = texgyrecursor,
      fea   = {+zero;},
      %% for completeness: false is anyway the default
      force = false,
    },
  }
\end{minted}
% \iffalse
%</verb>
% \fi
%
% This section describes these ‘inner’ keys.
%
% \subsubsection{Common keys}\label{subsubsec:common}
%
% These keys accepted by all of \texttt{rm}, \texttt{sf}, \texttt{tt}, \texttt{fam}
% and \texttt{math}.
%
% \DescribeKey{name}\val{lookup name}\par
% The ‘name’ to lookup.
% This may, but need not be, the name of a font family.
% Shorter, less specific names will configure more families; longer, more
% specific names will configure fewer.
%
% For example, \texttt{name = texgyrepagellax,} will configure fewer than 
% \texttt{name = texgyrepagella,} since the latter string matches both 
% families, while the former does not.
% 
% The name is lower-cased prior to lookup. 
% The data used to generate actual font families uses a cleaned up version 
% of the given name or, sometimes, a variation, depending on the data
% returned from the database.
%
% For example, \texttt{tex gyre PaGellA} yields the same results as 
% \texttt{texgyrepagella}.
%
% Numbers are likewise removed\footnote{%
%   This is problematic for fonts which depend on digits in their names to 
%   distinguish them e.g.~Venturis ADF has four distinct ‘titling’ 
%   fonts, whose names differ by a single character, which is \texttt{1}, 
%   \texttt{2}, \texttt{3} or \texttt{4}. 
%   The algorithm used to sort the fonts into \textsc{nfss} families 
%   currently gets confused by this, leading to misleading warnings 
%   about ‘apparent duplicate’ fonts. 
%   (Something is indeed awry, but they are not duplicates.
%   Rather what should be four families appears to be only one.)%
% }.
%
%
% \DescribeKey{force}\vals{true,false}\par
% Boolean which determines whether cached data is to be regenerated on the 
% basis of a new search of the font-loader's database.
%
% Note that this doesn't regenerate the loader's database itself. 
% It simply zaps data stored by this module for one or more font families.
%
% \DescribeKey{scale}\val{factor}\par
% Optional factor by which the font should be scaled e.g.~\texttt{20} or 
% \texttt{0.8}.
% Ignored if a family includes distinct optical sizes.
%
% \subsubsection{Text-mode keys}\label{subsubsec:keys-text}
% These keys are accepted in all key-value specifications except for the 
% top-level \texttt{math} key used to configure Unicode maths.
%
% Currently there is only one key in this category.
%
% \DescribeKey{fea}\val{opentype feature spec.}\par
% Optional list of font features \textbf{for text fonts only}. 
% 
% Note that the specification is currently passed to the font loader with 
% minimal processing, so you must use ‘raw’ feature specifications.
%
\iffalse
% The default is \texttt{script=dflt}, \texttt{mode=node}, \texttt{+tlig},
% \texttt{language=dflt}.
\fi
% The default is \texttt{fea=}%
%   \marg{mode=node;scrpt=dflt;language=dflt;+tlig}.
% Unless provided in separate fonts, \texttt{+smcp} is added, if available, 
% for upright, italic and oblique small-caps.
% 
% Features apply to \emph{all} fonts configured as a result of the lookup, so
% you should not specify features you do not wish applied to all fonts to which
% the specification applies.
% 
% \subsubsection{Default text family keys}\label{subsubsec:keys-text-def}
% These keys are accepted by \texttt{rm}, \texttt{sf} and \texttt{tt} i.e.~when
% specifying the default text families for the document.
%
% These keys all do the same thing, so you may use your preferred syntactic
% sweetener. 
%
% \DescribeKey{math}\vals{true,false}\par
% \DescribeKey{maths}
% Should the current specification also be used for the corresponding text
% family in maths?
%
% For example, if you are configuring the main document family with 
% \texttt{rm}, should that family also be used for operators, \cs{mathrm} etc.?
%
% The default is equivalent to \texttt{math = true}.
%
% \DescribeKey{nomath}
% \DescribeKey{nomaths}
% Equivalent to \texttt{math = false}.
%
% \section{Examples}\label{sec:eeiau}
%
% \lfcdocfile [label=example-lmr] {example-lmr}
%
% \lfcdocfile [label=example-ncm-math] {example-ncm-math}
%
% \lfcdocfile [label=example-ncm-complete] {example-ncm-complete}
%
% \lfcdocfile [label=example-fea] {example-fea}
%
% \lfcdocfile [label=example-talk,rangestartstring={\\DocumentMetadata}]{example-talk}
%
% \changes{v0.0}{0000-00-00}{First public release.}
%
% \MaybeStop{%
%   \PrintChanges
%   \PrintIndex
% }
% 
% \section{Implementation}
%
% There is very little here, because almost everything is done in Lua.
%
