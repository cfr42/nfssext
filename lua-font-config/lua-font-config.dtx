% \begin{variable}{\l_@@_tmpa_tl,\l_@@_tmpa_bool}
%   Custom ephemeral variables.
%    \begin{macrocode}
\tl_new:N \l__@@_tmpa_tl
\bool_new:N \l__@@_tmpa_bool
%    \end{macrocode}
% \end{variable}
%    \begin{macrocode}
%    \end{macrocode}
% Configure keys for default families.
%    \begin{macrocode}
\clist_map_inline:nn {rm, sf, tt} {
  \keys_define:nn {lfc} {
    #1 .code:n            = { 
      \keys_set_exclude_groups:nnnN {lfc/#1} {config} {##1} \l__@@_tmpa_tl
      \keys_set:nV {lfc/#1} \l__@@_tmpa_tl
      \bool_set_true:N \l_@@_tmpa_bool
    },
    #1 .value_required:n  = true,
    #1 .usage:n           = preamble,
  }
  \keys_define:nn {lfc/#1} {
    name      .code:n = { \use:c {__@@_set_#1:n} {##1} },
    features  .code:n = { \keys_set:nn {lfc/fam} {features = {##1} }},
    scale     .code:n = { \keys_set:nn {lfc/fam} {scale    = {##1} }},
    force     .code:n = { \keys_set:nn {lfc/fam} {force    = {##1} }},
    unknown   .code:n = {
      \exp_args:NnV \use:c {__@@_set_#1:n} \l_keys_key_str
      \bool_set_true:N \l_@@_tmpa_bool
    },
    name      .value_required:n   = true,
    unknown   .value_forbidden:n  = true,
    features  .groups:n           = config,
    scale     .groups:n           = config,
    force     .groups:n           = config,
  }
}
%    \end{macrocode}
% Configure keys for additional families, debugging etc.
%    \begin{macrocode}
\keys_define:nn {lfc} {
  debug   .code:n           = { 
    \keys_set:nn {lfc/debug} {
      state       = true,
      categories  = {"doc"},
      #1
    } 
  },
  debug   .usage:n          = general,
  family  .code:n           = { 
    \keys_set_exclude_groups:nnnN {lfc/fam} {config} {#1} \l__@@_tmpa_tl
    \keys_set:nV {lfc/fam} \l__@@_tmpa_tl
    \bool_set_true:N \l_@@_tmpa_bool
  },
  family  .value_required:n = true,
  family  .usage:n          = general,
}
\keys_define:nn {lfc/fam} {
  name      .code:n = { \__@@_set_fam_name:n {#1} },
  features  .code:n = { \__@@_set_fam_cfg:nn {fea}{#1} },
  scale     .code:n = { \__@@_set_fam_cfg:nn {scale}{#1} },
  force     .code:n = { \__@@_set_fam_cfg:nn {force}{#1} },
  unknown   .code:n = {
    \exp_args:NV \__@@_set_fam_name:n \l_keys_key_str 
    \bool_set_true:N \l_@@_tmpa_bool
  },
  name      .value_required:n   = true,
  features  .value_required:n   = true,
  scale     .value_required:n   = true,
  force     .default:n          = true,
  unknown   .value_forbidden:n  = true,
  name      .usage:n            = general,
  features  .usage:n            = general,
  scale     .usage:n            = general,
  force     .usage:n            = general,
  unknown   .usage:n            = general,
  features  .groups:n           = config,
  scale     .groups:n           = config,
  force     .groups:n           = config,
}
\keys_define:nn {lfc/debug} {
  state       .choice:,
  state/false .code:n             = { \_@@_debug_set_false: },
  state/true  .code:n             = { \_@@_debug_set_true: },
  categories  .code:n             = { \_@@_debug_set_cats:n {#1} },
  state       .default:n          = true,
  state       .usage:n            = general,
  categories  .value_required:n   = true,
  categories  .usage:n            = general,
}
%    \end{macrocode}
% \begin{macro}{\fontconfig}
%   The main (and currently(?) only) macro.
%    \begin{macrocode}
\NewDocumentCommand\fontconfig { +m }{
  \bool_set_false:N \l_@@_tmpa_bool
  \keys_set:nn {lfc} {#1}
  \bool_if:NT \l_@@_tmpa_bool {
    \__@@_configure_doc_families:
  }
}
%    \end{macrocode}
% \end{macro}
