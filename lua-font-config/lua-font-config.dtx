% \usesafecs
% \Fontsettarg*\ get functios such as \cs{_@@_font_set_default:} where \texttt{default} is either literal or the name of a configured meta-family.
% \resetcs
%
%   The following removes various commands from \cs{@preamblecmds}, allowing them to be used in the body of the document and not only in the preamble.
%
%   This approach is based on David Carlisle's suggestions at \url{https://chat.stackexchange.com/transcript/message/69314513#69314513}.
%   David suggested setting the entire list \cs{@preamblecmds} empty, but I don't really think an alternative font loader (?) should be in the business of e.g.~enabling use of \cs{usepackage} (or \cs{documentstyle}!) inside the \texttt{document} environment.
%   So let's try editing the list instead \dots.
%
%   We don't enable anything disallowed for text fonts.
%   But we do want to allow new math versions and the assignment of maths fonts to those versions: specifically, we want \cs{SetMathAlphabet} and \cs{SetSymbolFont} to be usable, as well as configuration of new Unicode math fonts.
%   This avoids the need to predefine additional maths versions for switching \fontsettarg*, so we can define them only if the font set is actually enabled in the document.
%   It also means we can avoid even doing the configuration and setting the definitions up if a set is never used.
% \begin{macro}{\@preamblecmds}%% ^^A <<<
%   Listed macros\footnote{%
%     Except \texttt{do}, obviously.%
%   } will be permitted in the document, overriding the \LaTeX{} restriction.
%    \begin{macrocode}
\tl_set:Nn \l_@@_tmpb_tl {
  \do
  \alpha@elt
  \alpha@list
  \cdp@elt
  \cdp@list
  \DeclareMathVersion
  \DeclareMathAlphabet
  \DeclareSymbolFont
  \dorestore@version
  \get@cdp
  \group@elt
  \group@list
  \init@restore@version
  \new@mathalphabet
  \new@mathgroup
  \new@mathversion
  \new@symbolfont
  \restore@mathversion
  \SetMathAlphabet
  \SetMathAlphabet@
  \SetSymbolFont@
  \SetSymbolFont
  \version@elt
  \version@list
}
\tl_clear:N \l_@@_tmpa_tl
\tl_map_inline:Nn \@preamblecmds {
  \bool_set_true:N \l_@@_tmpa_bool
  \tl_map_inline:Nn \l_@@_tmpb_tl {
    \tl_if_eq:nnT {##1} {#1} {
      \bool_set_false:N \l_@@_tmpa_bool
      \tl_map_break:
    }
  }
  \bool_if:NT \l_@@_tmpa_bool {
    \tl_put_right:Nn \l_@@_tmpa_tl {\do #1}
  }
}
\tl_set_eq:NN \@preamblecmds \l_@@_tmpa_tl
%    \end{macrocode}
% \end{macro}%% ^^A >>>
% We are hypocrites: we help make \LaTeX{} preamble-only macros available in the document body, but we disallow use of our own there.
% This restriction is probably not necessary, but it is imposed pending the discovery of some compelling use-case requiring use in the document body.
% 
% For now, then, \cs{newfontset} and \cs{fontconfig} should not be used inside \texttt{document}.
% Is there a (similarly simple) way to do this in \pkg{expl3}?
% Well, I just learnt this from \pkg{babel} \dots, so maybe I'll find it in another few decades or so.
%    \begin{macrocode}
\ExplSyntaxOff
\@onlypreamble \newfontset
\@onlypreamble \fontconfig
%    \end{macrocode}
