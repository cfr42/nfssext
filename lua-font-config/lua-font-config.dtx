% \begin{keyname}{features}%% ^^A <<<
% \changes{v0.2}{2026-10-29}{Initial \texttt{features} keys: \texttt{alternates}, \texttt{embolden}, \texttt{figures}, \texttt{forms}, \texttt{language}, \texttt{ligatures}, \texttt{node}, \texttt{script}, \texttt{spacing}.}
% \changes{v0.0}{2026-11-05}{Add \texttt{scope} key.
%   This provides a more user-friendly wrapper around the \texttt{scoped} key.}
% \changes{v0.0}{2026-11-21}{Renamed \texttt{standard}, \texttt{nostandard} \texttt{ligatures} keys \texttt{common}, \texttt{nocommon} as this seems more \dots, er, standard.}
% \begin{keyname}{features/alternates,
%   features/embolden,
%   features/figures,
%   features/forms,
%   features/language,
%   features/ligatures,
%   features/mode,
%   features/scope,
%   features/script,
%   features/spacing,
% }%% ^^A <<<
%   Trying to be a more user-friendly wrapper around \texttt{fam/fea}.
%    \begin{macrocode}
\keys_define:nn {lfc/features} {
  alternates  .code:n = {
    \exp_args:NV \__@@_set_fam_features:nnn \l_@@_scope_str {alternates} {#1}
  },
  embolden    .code:n = {
    \seq_put_right:Nn \l_@@_features_seq {embolden=#1}
  },
  figures     .code:n = {
    \exp_args:NV \__@@_set_fam_features:nnn \l_@@_scope_str {figures} {#1}
  },
  forms         .code:n = {
    \exp_args:NV \__@@_set_fam_features:nnn \l_@@_scope_str {forms} {#1}
  },
  language      .code:n = {
    \seq_put_right:Nn \l_@@_features_seq {language=#1}
  },
  ligatures     .code:n = {
    \exp_args:NV \__@@_set_fam_features:nnn \l_@@_scope_str {ligatures} {#1}
  },
  mode          .choices:nn = {base,node,harf}{
    \seq_put_right:Ne \l_@@_features_seq {mode=\l_keys_choice_str}
  },
  scope           .code:n = {
    \seq_set_split:Nnn \l_@@_scope_seq {,} {,,,}
    \keys_set:nn {lfc/features/scoped} {#1}
    \seq_map_indexed_inline:Nn \l_@@_scope_seq {
      \int_case:nn {##1} {
        {1} { \str_set:Nn \l_@@_tmpa_str {##2} }
        {2} { 
          \bool_case:nF {
            { %% weight empty, width empty --> use *
              \bool_lazy_and_p:nn { \str_if_empty_p:n {##2} } {
                \str_if_empty_p:N \l_@@_tmpa_str }
            } { \str_set:Nn \l_@@_scope_str {*} }
            { %% weight m, width non-empty --> use width
              \bool_lazy_and_p:nn { \str_if_eq_p:Vn \l_@@_tmpa_str {m} } {
                ! \str_if_empty_p:n {##2} }
            } { \str_set:Nn \l_@@_scope_str {##2} }
            { %% weight non-empty, width m --> use weight
              \bool_lazy_and_p:nn { ! \str_if_empty_p:N \l_@@_scope_str } {
                \str_if_eq_p:nn {##2} {m} }
            } { \str_set_eq:NN \l_@@_scope_str \l_@@_tmpa_str }
          } { %% o/w --> use concat
            \str_set:Ne \l_@@_scope_str {\l_@@_tmpa_str ##2}
          }
          \str_put_right:NV \l_@@_scope_str \c_colon_str 
        }
        {3} { \str_set:Nn \l_@@_tmpa_str {##2} }
        {4} {
          \bool_case:nF {
            { %% shape empty, case empty --> use *
              \bool_lazy_and_p:nn { \str_if_empty_p:n {##2} } {
                \str_if_empty_p:N \l_@@_tmpa_str
              }
            } { \str_put_right:Nn \l_@@_scope_str {*} }
            { %% shape n, case non-empty --> use case
              \bool_lazy_and_p:nn { \str_if_eq_p:Vn \l_@@_tmpa_str {n} } { 
                ! \str_if_empty_p:n {##2} }
            } { \str_put_right:Nn \l_@@_scope_str {##2} }
            { %% shape non-empty, case n --> use shape
              \bool_lazy_and_p:nn { ! \str_if_empty_p:N \l_@@_tmpa_str } {
                \str_if_eq_p:nn {##2} {n} }
            } { \str_put_right:NV \l_@@_scope_str \l_@@_tmpa_str }
          } { %% o/w --> concat
            \str_put_right:Ne \l_@@_scope_str {\l_@@_tmpa_str ##2}
          }
        }
      }
    }
  },
  scoped / weight .choices:nn = {bold, book, demibold, extralight, extrabold,
    light, medium, regular, semibold, semilight, ultralight, ultrabold} {
    \exp_args:NNne \seq_set_item:Nnn \l_@@_scope_seq {1} {
      \__@@_parse_spec:nV {weight} \l_keys_choice_str
    }
  },
  scoped / width  .choices:nn = {condensed, expanded, extracondensed,
    extraexpanded, medium, semicondensed, semiexpanded, ultracondensed,
    ultraexpanded} { 
    \exp_args:NNne \seq_set_item:Nnn \l_@@_scope_seq {2} {
      \__@@_parse_spec:nV {width} \l_keys_choice_str
    }
  },
  scoped / case   .choices:nn = {mixed, smallcaps} {
    \exp_args:NNne \seq_set_item:Nnn \l_@@_scope_seq {3} {
      \__@@_parse_spec:nV {case} \l_keys_choice_str
    }
  },
  scoped / style  .choices:nn = {italic, oblique, upright} {
    \exp_args:NNne \seq_set_item:Nnn \l_@@_scope_seq {4} {
      \__@@_parse_spec:nV {shape} \l_keys_choice_str
    }
  },
  script        .code:n = {
    \seq_put_right:Nn \l_@@_features_seq {script=#1}
  },
  spacing       .code:n = {
    \exp_args:NV \__@@_set_fam_features:nnn \l_@@_scope_str {spacings} {#1}
  },
  alternates  .value_required:n = true,
  embolden    .value_required:n = true,
  figures     .value_required:n = true,
  forms       .value_required:n = true,
  language    .value_required:n = true,
  ligatures   .value_required:n = true,
  mode        .value_required:n = true,
  scope       .value_required:n = true,
  script      .value_required:n = true,
  spacing     .value_required:n = true,
  scope       .groups:n         = scope,
}
%    \end{macrocode}
