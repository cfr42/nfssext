% \subsection{Font sets}\label{subsec:font-sets}% ^^A <<<
%
% \hypertarget{subsec:font-sets-t}{Font sets} allow multiple, independent sets of fonts to be used in a document, in such a way that standard commands such as \cs{textsf}, \cs{bfseries} and \cs{boldmath} ‘just work’.
%
%
% \begin{description}
%   \item[Name:]          \textbf{font set}
%   \item[Concept:]       A complete set of fonts which may be activated at any point in the body of the document.
%   \item[Behaviour:]     At any point during typesetting, exactly one font set should be active; activating an alternative font set should deactivate the current one.
%     While active, a font set determines the effect of all standard font selection commands for both \texttt{text} and \texttt{math} modes.
%   \item[Default:]       The \texttt{default} font set should always be present and active at the start of the document body.
%   \item[Configuration:] Font sets should be configured independently of each other.
%     The effect of switching to a different font set should produce the same behaviour as configuring that font set for the whole document.
%   \item[Components:]    A font set consists of the following:
%     \begin{itemize}
%       \item A unique name.
%         \texttt{default} is reserved for the default font set.
%         There are some restrictions on names, but any other combination of lowercase Latin letters is certainly safe.
%         Names must be unique.
%       \item A serif/roman/main family, either specified using the \texttt{rm} key (\cref{sec:pkg}) or \texttt{lmr}. 
%       \item A sans family, either specified using the \texttt{sf} key (\cref{sec:pkg}) or \texttt{lmss}. 
%       \item A typewriter/monowidth/mono family, either specified using the \texttt{tt} key (\cref{sec:pkg}) or \texttt{lmtt}. 
%       \item A Unicode maths family, together with families for script and calligraphic alphabets, either specified using the \texttt{math} key (\cref{sec:pkg}) or \texttt{lmm}.
%       \item Per-family weights for the default and bold series used in text (\cs{textbf} etc.). 
%       \item \texttt{normal} and \texttt{bold} versions for mathematics, \emph{provided these are accessed using \cs{normalmath} and \cs{boldmath}}.
%     \end{itemize}
%   \item[Purpose:]       Documents which \emph{require} multiple font configurations e.g.~multilingual documents involving different scripts, features etc., older texts with contemporary commentaries, where the primary text should reflect typesetting conventions which have since changed (long ‘s’, ‘ß’) or documents which use the same mathematical characters with differences in meaning and spacing.
%     Font sets are intended to allow easy setup of, and seamless switches between, the various configurations necessary.
% \end{description}
%
% \textbf{Additional\footnote{%
%     Technically, \pkg{lua-font-config} always uses font sets, but most documents require only the \texttt{default} font set.
%     In this case, \pkg{lua-unicode-math} is not required (unless the top-level \texttt{math} key is used).%
%   } %
% font sets require \pkg{lua-unicode-math}.}
% The package will be automatically loaded, if necessary, or an error produced, if the incompatible \pkg{unicode-math} is already loaded.
%
% \subsubsection{A schematic example}\label{subsubsec:font-set-ee}
%
% To configure font sets \texttt{seta} and \texttt{setb}, proceed as follows:
% \iffalse
%<*verb>
% \fi
\begin{minted}{latex}
\usepackage{lua-font-config}
% The default font set **MUST** be configured first.
\fontconfig{%
  % Specify **at least one** of rm, sf, tt and math.
  % It is fine to specify a LaTeX default if you don't want to change it.
  rm = lmr,
  % Specify any additional special families required.
  % family = {...},
}
% Initialise our additional font sets.
\newfontset{seta}
\newfontset{setb}
% Configure font set ‘seta’.
\fontconfig[seta]{%
  % Specify **at least one of rm, sf, tt, math.
  ...
}
% Configure font set ‘setb’.
\fontconfig[setb]{%
  % Specify **at least one of rm, sf, tt, math.
  ...
}
\end{minted}
% \iffalse
%</verb>
% \fi
% The \texttt{default} set will be active when the document begins. 
% Use
% \iffalse
%<*verb>
% \fi
\begin{minted}{latex}
\usefontset{seta}
\end{minted}
% \iffalse
%</verb>
% \fi
% to switch to \texttt{seta},
% \iffalse
%<*verb>
% \fi
\begin{minted}{latex}
\usefontset{seta}
\end{minted}
% \iffalse
%</verb>
% \fi
% to activate \texttt{setb} and
% \iffalse
%<*verb>
% \fi
\begin{minted}{latex}
\usefontset{default}
\end{minted}
% \iffalse
%</verb>
% \fi
% to restore the \texttt{default} set.
%
% \subsubsection{Commands}\label{subsubsec:font-set-macros}
%
% Use \cs{newfontset} to initialise font sets, \cs{fontconfig} to configure them and \cs{usefontset} to activate them in your document.
% 
% \DescribeMacro{\newfontset}\oarg{base-identifier}\marg{new-identifier}\par
% Initialise a font set \meta{new-identifier}, optionally based on an existing font set \meta{base-identifier}.
%
% \emph{Apart from the \texttt{default} font set, which is initialised automatically, all font sets must be initialised using this command prior to configuration.}
%
% \cs{fontconfig}\oarg{identifier}\marg{key-value list} should then be used to configure the font set in the usual way (\cref{sec:pkg}).
% 
% \emph{All font sets must be configured with \cs{fontconfig} before they may be used.}
%
% \cs{newfontset} and \cs{fontconfig} are available in the preamble of the document.
%
% \DescribeMacro{\usefontset}\marg{identifier}\par
% Switch to font set \meta{identifier}.
%
% This command is available at any point in the body of the document.
%
% \cs{usefontset}\marg{default} may be used to restore the default font set.
%
% \DescribeMacro{\normalmath} Switch to the \texttt{normal} maths version of the current font set.
%
% \DescribeMacro{\boldmath} Switch to the \texttt{bold} maths version of the current font set.
%
% \cs{boldmath} is redefined by \cs{usefontset} to adjust the result to the active configuration.
%
% \cs{normalmath} is similarly redefined, but since it is not provided by \LaTeX{}, a suitable definition is provided by the package as a baseline.
% Although this command is documented here, where it seems potentially of some interest, it is provided whether additional font sets are used or not\footnote{%
%   In fact, it is provided even if nothing is configured with \cs{fontconfig}, so that the document fonts are untouched.
%   In that case, it just works analogously to \cs{boldmath}.%
% }.
% \bigskip
%
% Note that font sets are isolated\footnote{%
%   I have not yet decided if this is a feature, a misfeature, a limitation or a bug.
%   This is one of several aspects of the implementation which is strictly provisional and feedback would therefore be especially welcome.%
% }.
%
%% ^^A >>>
%
% \subsection{Advanced configuration}\label{subsec:adv}% ^^A <<<
%
% \texttt{fea} and \texttt{scoped} provide a relatively lower-level interface to the functionality provided by the \texttt{features} key.
% They apply to the configuration of text families only and require familiarity with both \textsc{nfss}, \pkg{luaotfload} and opentype feature tags.
%
% These keys are faster and more powerful than the keys described earlier.
% They may be used in the same places as \texttt{features} (\cref{subsubsec:keys-text}).
%
% \textbf{If you are not sure which to use or lack familiarity with \textsc{nfss}, \pkg{luaotfload} or opentype feature tags, use \texttt{features}.}
%
% \texttt{fea} and \texttt{features} may be used to configure the same family.
% If so, consistent options are combined; in case of conflicts, \texttt{features} takes precedence over \texttt{fea}.
% This means you can use the more-user friendly interface for most things and still add any unsupported specialist setup, if necessary. 
%
% \DescribeKey{fea}\mval{opentype feature spec.}\par
% Optional list of font features \textbf{for text fonts only}. 
% 
% Note that the specification is passed to the font loader with minimal processing, so you must use ‘raw’ feature specifications.
% \emph{If you do not know what these are, use the \texttt{features} key rather than this one; if you need an unsupported feature, file an issue on the bug tracker (link below).}
%
% The default is equivalent to \texttt{fea=\{mode=node;scrpt=dflt;language=dflt;+tlig\}}.
% Unless provided in separate fonts, \texttt{+smcp} is added, if available, for upright, italic and oblique small-caps.
% 
% Features apply to \emph{all} fonts configured as a result of the lookup, so you should not specify features you do not wish applied to all fonts to which the specification applies.
%
% For example,
% \iffalse
%<*verb>
% \fi
\begin{minted}{latex}
  \usepackage{lua-font-config}
  \fontconfig{%
    rm = {%
      name = texgyrepagella, 
      fea  = {script=ltn;+tlig;+pnum},
      % apply ‘capital spacing’ to small-caps upright/italic/oblique
      scoped = {*:sc}{+cpsp},
      scoped = {*:scit}{+cpsp},
      scoped = {*:scsl}{+cpsp},
    },
    sf = {%
      name  = texgyreheros,
      scale = 1.2,
      fea   = {script=cyrl;},
    },
    tt = {%
      name  = texgyrecursor,
      fea   = {+zero;},
      %% for completeness: false is anyway the default
      force = false,
    },
  }
\end{minted}
% \iffalse
%</verb>
% \fi
%
% \DescribeKey{scoped}\mval{scope spec.}\marg{opentype feature spec.}\par
% Optional list of font features \textbf{for a subset of text fonts only}. 
%
% \meta{scope spec.} is a colon-separated expression consisting of a series specifier followed by a shape specifier i.e.~\meta{series}\texttt{:}\meta{shape}.
% One expression may be \texttt{*} meaning all series or all shapes.
%
% For example, \texttt{scoped={*:sc}{+cpsp}} would add ‘capital spacing’ to all small-caps fonts, regardless of series.
%
% \meta{series} and \meta{shape} have take the usual \texttt{nfss} values, except that \texttt{book} is \texttt{k}, if a family also has a regular variant, and \texttt{medium} is \texttt{f}, if a family also has either book or regular.
% \textbf{These specifiers are non-standard and may change without notice, if I can think of a way to avoid them.}
% 
% Features apply \emph{only} to fonts covered by \meta{scope spec.}
% The \meta{opentype feature spec.} is \emph{added} to the features applied to all fonts configured by the lookup.
% So, if you want oldstyle figures for all fonts except bold oblique, you must add \texttt{+lnum} for the \texttt{b:sl} scope.
% 
% Note that both the scope and feature specifications are passed to \LaTeX{} and the font loader with minimal processing, so you must use low-level series/shape representations and ‘raw’ feature specifications.
% \emph{If you do not know what these are, use the \texttt{features} key rather than this one; if you need an unsupported feature, file an issue on the bug tracker (link below).}
% 
% Note that although arbitrary scopes and features may minimally work, \textbf{this is not recommended}.
% The intended usage is to change spacing or figures in small-caps variants (see \cref{fig:ee-scoped}), say, or to substitute petite for small caps or make similar adjustments.
% In particular, note that the underlying family names become unpredictable and possibly inconsistent if too many changes create a hodgepodge rather than a coherent family.
% Moreover, documents typeset with such fonts will generally be typographically inconsistent, too.
% If more variety is really needed, create additional font families and switch between them rather than abusing \texttt{scoped}.
%
% Note that this key cannot be used to add ‘fake’ fonts: you cannot add a fake bold or oblique this way.
% Use \texttt{fakebold}, \texttt{fakeoblique} etc.\ (\cref{subsubsec:keys-text}) for this, if necessary.
%
%% ^^A >>>
%% ^^A >>>
%
% \twreg
%
% \section{Compatibility}\label{sec:compat}% ^^A <<<
% 
% \subsection{\pkg{fontspec}}\label{subsec:compat-fontspec}
%
% The package should be compatible with \pkg{fontspec}, provided particular fonts are configured with commands from one or neither package.
% However, this is not tested and obviously documents cannot benefit from any performance gains to the extent they rely on \pkg{fontspec}\footnote{%
%   But \pkg{fontspec}'s performance is quite good if you do not use fonts with \texttt{.fontspec} files or which are especially large.
%   E.g.~Latin Modern and \TeX-Gyre fonts are generally fine, but New Computer Modern is rather painful.%
% }.
%
% \subsection{\cls{ltx-talk}}\label{subsec:compat-talk}
%
% Load with \cs{RequirePackage} \emph{before} loading the class.
% The package emulates the class settings by default, so the main benefit of loading it is speed.
% If you wish to change the fonts, use \cs{fontconfig} after the class is loaded\footnote{%
%   If this turns out to be something people want to do, I can adjust things to avoid configuring fonts twice.
%   For now, this is just a good way for me to test the code and avoid the pain of watching \pkg{fontspec} load New Computer Modern.%
% }.
%
% \subsection{\pkg{lua-unicode-math}}\label{subsec:compat-lum}
%
% \pkg{lua-font-config} is definitely compatible with \pkg{lua-unicode-math} and will load it if the top-level \texttt{math} key is used for Unicode maths or a non-default \fontsettarg\ is created.
% Note that if you do use the \texttt{math} key and in any case for additional font sets, none of the \texttt{.fd} or font-specific \texttt{.sty} files will be used; instead, the maths fonts will be configured using the same process as the text fonts and results cached in the same way.
% If you would prefer to use the \texttt{.fd} files from \pkg{lua-unicode-math}, but don't want to load one of the font-specific packages it provides, you can do so by using the correct family name in \cs{fontconfig}.
% For example, the following should use \pkg{lua-unicode-math}'s font definitions from \texttt{tueuler-math.fd}, \texttt{tueuler-math-sf.fd} and \texttt{tueuler-math-ssf.fd} for Euler Math, without loading \pkg{lum-euler}.
% \iffalse
%<*verb>
% \fi
\begin{minted}{latex}
\fontconfig{%
  math = euler-math,
}
\end{minted}
% \iffalse
%</verb>
% \fi
% In general, \pkg{lua-font-config} will read existing font definitions, where these are available, but this requires an exact name match.
%
% \subsection{\pkg{unicode-math}}\label{subsec:compat-um}
%
% The package should be compatible with \pkg{unicode-math}, provided neither the top-level \texttt{math} key (for Unicode maths configuration) nor (non-default) \fontsettarg*\ are used.
% See \cref{subsec:compat-fontspec}, but there is really no performance reason to use \pkg{lua-font-config} in this case, since \pkg{unicode-math} is extremely slow and this will easily dominate the time taken for font configuration.
% In general, I see no reason to use \pkg{lua-font-config} together with \pkg{unicode-math}; if you need the latter, there is really no reason to use \pkg{lua-font-config} at all.
%
%% ^^A >>>
