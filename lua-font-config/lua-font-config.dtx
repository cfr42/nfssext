% \begin{keyname}{fam}%% ^^A <<<
%   Configure keys for families.
%   \changes{v0.2}{2026-10-29}{Add \texttt{fea} user-interface wrapper: \texttt{features} provides a key-value interface for configuration.}
%   \changes{v0.0}{2026-11-06}{Add \texttt{scoped} key: low-level interface to configure font features selectively. 
%     This is intended to complement the \texttt{fea} key and similarly supports expert/advanced usage, prioritising performance with few checks and a relatively low-level interface.}
% \begin{keyname}{fam/name,fam/fakebold,fam/fakeoblique,fam/fea,fam/features,fam/force,fam/hyphenchar,fam/scale,fam/scoped}%% ^^A <<<
%   Configure keys for families.
%   \changes{v0.0}{2026-11-07}{Add \texttt{scoped}, \texttt{fakebold}, \texttt{fakeoblique}.}
%   \changes{v0.0}{2026-11-10}{Add \texttt{hyphenchar}.}
%
%   Note to self: \pkg{l3keys} does not work the way you think!!!
%   \emph{The hierarchy is not a tree!}
%    \begin{macrocode}
\keys_define:nn {lfc/fam} {
  name        .code:n = { \__@@_set_fam_name:n {#1} },
  command     .code:n = { 
    \exp_args:Nne \__@@_set_fam_cfg:nn {csname}{ \cs_to_str:N #1 }
  },
  fakebold    .code:n = {
    \__@@_set_fam_cfg:nn {fakebold} {#1}
  },
  fakeoblique .code:n = {
    \__@@_set_fam_cfg:nn {fakeoblique} {#1}
  },
  fea         .code:n = { \__@@_set_fam_cfg:nn {fea} {#1} },
  features    .code:n = { 
    \seq_clear:N \l_@@_features_seq
    \str_set:Ne \l_@@_scope_str {*\c_colon_str*}

    \keys_set_groups:nnnN {lfc/features} {scope} {#1} \l_@@_tempc_tl
    \keys_set:nV {lfc/features} \l_@@_tempc_tl 

    \seq_if_empty:NF \l_@@_features_seq {
      \str_if_eq:eeTF {\l_@@_scope_str} {\c_@@_scope_default_str} {
        \exp_args:Nne \__@@_set_fam_cfg:nn {fea} {
          \seq_use:Nn \l_@@_features_seq {;}
        }
      } {
        \__@@_set_fam_scoped_fea:Ve \l_@@_scope_str {
          \seq_use:Nn \l_@@_features_seq {;}
        }
      }
    }
    \str_clear:N \l_@@_scope_str
  },
  force         .code:n = { \__@@_set_fam_cfg:nn {force}{#1} },
  hyphenchar    .choices:nn = {false,true}{
    \__@@_set_fam_cfg:nn {hyphenchar}{#1}
  },
  scale         .code:n = { \__@@_set_fam_cfg:nn {scale}{#1} },
  scoped.code:n = {
    \str_set:Ne \l_@@_tmpa_str {
      \_@@_second_of_two:w #1 \q_stop
    }
    \str_if_empty:NTF \l_@@_tmpa_str {
      \__@@_set_fam_cfg:nn {fea} {#1}
    } {
      \__@@_set_fam_scoped_fea:nn #1
    }
  },
  unknown   .code:n = {
    \exp_args:NV \__@@_set_fam_name:n \l_keys_key_str 
  },
  name          .value_required:n   = true,
  fakebold      .default:n          = 1.5,
  fakeoblique   .default:n          = 0.2,
  fea           .value_required:n   = true,
  features      .value_required:n   = true,
  force         .default:n          = true,
  hyphenchar    .default:n          = true,
  scale         .value_required:n   = true,
  scoped        .value_required:n   = true,
  unknown       .value_forbidden:n  = true,
  name          .usage:n            = general,
  command       .usage:n            = general,
  fea           .usage:n            = general,
  scoped        .usage:n            = general,
  features      .usage:n            = general,
  force         .usage:n            = general,
  scale         .usage:n            = general,
  unknown       .usage:n            = general,
  command       .groups:n           = config,
  fakebold      .groups:n           = config,
  fakeoblique   .groups:n           = config,
  fea           .groups:n           = config,
  features      .groups:n           = lateconfig,
  force         .groups:n           = config,
  hyphenchar    .groups:n           = config,
  scale         .groups:n           = config,
  scoped        .groups:n           = config,
}
%    \end{macrocode}
% \end{keyname}%% ^^A >>>
