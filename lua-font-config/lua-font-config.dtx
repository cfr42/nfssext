% \begin{variable}{\l_@@_features_seq,\l_@@_tmpa_bool,\l_@@_tmpa_tl,\l_@@_tmpb_tl}
%   Custom ephemeral variables.
%   \changes{v0.0}{2026-10-29}{Added \cs{l_@@_features_seq}, \cs{l_@@_tmpb_tl}.}
%    \begin{macrocode}
\bool_new:N \l_@@_tmpa_bool
\seq_new:N \l_@@_features_seq
\tl_new:N \l_@@_tmpa_tl
\tl_new:N \l_@@_tmpb_tl
%    \end{macrocode}
% \end{variable}
% \begin{keyname}{rm,sf,tt}
% Top-level keys for default text families.
%    \begin{macrocode}
\clist_map_inline:nn {rm, sf, tt} {
  \keys_define:nn {lfc} {
    #1 .code:n            = { 
      \tl_clear:N \l_@@_tmpa_tl
      \tl_clear:N \l_@@_tmpb_tl
      \keys_set_exclude_groups:nnnN {lfc/#1} {config} {##1} \l_@@_tmpa_tl
      \keys_set_groups:nnVN {lfc/#1} {config}     \l_@@_tmpa_tl \l_@@_tmpb_tl
      \keys_set_groups:nnV  {lfc/#1} {lateconfig} \l_@@_tmpb_tl
      \bool_set_true:N \l_@@_tmpa_bool
    },
    #1 .value_required:n  = true,
    #1 .usage:n           = preamble,
  }
%    \end{macrocode}
% \begin{keyname}{rm/name,rm/fea,rm/force,rm/scale,rm/maths,rm/math,rm/nomaths,rm/nomath}
% \begin{keyname}{sf/name,sf/fea,sf/force,sf/scale,sf/maths,sf/math,sf/nomaths,sf/nomath}
% \begin{keyname}{tt/name,tt/fea,tt/force,tt/scale,tt/maths,tt/math,tt/nomaths,tt/nomath}
% Configure keys for default text families.
%    \begin{macrocode}
  \keys_define:nn {lfc/#1} {
    name      .code:n = { \use:c {_@@_set_#1:n} {##1} },
    fea       .code:n = { \keys_set:nn {lfc/fam} {fea      = {##1}} },
    features  .code:n = { \keys_set:nn {lfc/fam} {features = {##1}} },
    force     .code:n = { \keys_set:nn {lfc/fam} {force    = {##1}} },
    scale     .code:n = { \keys_set:nn {lfc/fam} {scale    = {##1}} },
    maths     .code:n = { \_@@_set_fam_cfg:nn   {maths}{##1} },
    math      .meta:n = { maths = {##1} },
    nomaths   .meta:n = { maths = false },
    nomath    .meta:n = { nomaths },
    unknown   .code:n = {
      \exp_args:NnV \use:c {__@@_set_#1:n} \l_keys_key_str
    },
    name      .value_required:n   = true,
    math      .default:n          = true,
    maths     .default:n          = true,
    nomath    .value_forbidden:n  = true,
    nomaths   .value_forbidden:n  = true,
    unknown   .value_forbidden:n  = true,
    fea       .groups:n           = config,
    features  .groups:n           = lateconfig,
    force     .groups:n           = config,
    maths     .groups:n           = config,
    math      .groups:n           = config,
    nomath    .groups:n           = config,
    nomaths   .groups:n           = config,
    scale     .groups:n           = config,
  }
}
%    \end{macrocode}
% \end{keyname}
% \end{keyname}
% \end{keyname}
% \end{keyname}
% \begin{keyname}{debug,math}
% \begin{keyname}{family}
% Top-level keys for additional families, Unicode maths and debugging.
% \changes{v0.0}{2026-10-29}{\texttt{family} adjusted to support addition of \texttt{features} interface.}
%    \begin{macrocode}
\keys_define:nn {lfc} {
  debug   .code:n           = { 
    \tl_clear:N \l_@@_tmpa_tl
    \keys_set_groups:nnnN
      {lfc/debug} {toggle} {state = true, #1} \l_@@_tmpa_tl
    \keys_set:nV {lfc/debug} \l_@@_tmpa_tl
  },
  debug   .usage:n          = general,
  family  .code:n           = { 
    \tl_clear:N \l_@@_tmpa_tl
    \tl_clear:N \l_@@_tmpb_tl
    \keys_set_exclude_groups:nnnN 
                          {lfc/fam} {config,lateconfig} {#1} \l_@@_tmpa_tl
    \keys_set_groups:nnVN {lfc/fam} {config}      \l_@@_tmpa_tl \l_@@_tmpb_tl
    \keys_set_groups:nnV  {lfc/fam} {lateconfig}  \l_@@_tmpb_tl
    \bool_set_true:N \l_@@_tmpa_bool
  },
  family  .value_required:n = true,
  family  .usage:n          = general,
  math    .code:n           = { 
    \IfPackageLoadedTF {unicode-math} {
      \msg_error:nn {lfc} {math-needs-lum}
    } {
      \msg_info:nnn {lfc} {loading} {lua-unicode-math} 
      \RequirePackage{lua-unicode-math}
      \tl_clear:N \l_@@_tmpa_tl
      \keys_set_exclude_groups:nnnN {lfc/math} {config} {#1} \l_@@_tmpa_tl
      \keys_set:nV {lfc/math} \l_@@_tmpa_tl
      \bool_set_true:N \l_@@_tmpa_bool
    }
  },
  math    .value_required:n = true,
  math    .usage:n          = preamble,
}
%    \end{macrocode}
% \end{keyname}
% \end{keyname}
% \begin{keyname}{fam/name,fam/fea,fam/features,fam/force,fam/scale}
% Configure keys for families.
% \changes{v0.0}{2026-10-29}{Add \texttt{fea} user-interface wrapper: \texttt{features} provides a key-value interface for configuration.}
%    \begin{macrocode}
\keys_define:nn {lfc/fam} {
  name      .code:n = { \__@@_set_fam_name:n {#1} },
  command   .code:n = { 
    \exp_args:Nne \__@@_set_fam_cfg:nn {csname}{ \cs_to_str:N #1 }
  },
  fea       .code:n = { \__@@_set_fam_cfg:nn {fea}{#1} },
  features  .code:n = { 
    \seq_clear:N \l_@@_features_seq
    \keys_set:nn {lfc/features} {#1} 
    \seq_if_empty:NF \l_@@_features_seq {
      \exp_args:Nne \__@@_set_fam_cfg:nn {fea} {
        \seq_use:Nn \l_@@_features_seq {;}
      }
    }
  },
  force     .code:n = { \__@@_set_fam_cfg:nn {force}{#1} },
  scale     .code:n = { \__@@_set_fam_cfg:nn {scale}{#1} },
  unknown   .code:n = {
    \exp_args:NV \__@@_set_fam_name:n \l_keys_key_str 
  },
  name      .value_required:n   = true,
  fea       .value_required:n   = true,
  features  .value_required:n   = true,
  force     .default:n          = true,
  scale     .value_required:n   = true,
  unknown   .value_forbidden:n  = true,
  name      .usage:n            = general,
  command   .usage:n            = general,
  fea       .usage:n            = general,
  features  .usage:n            = general,
  force     .usage:n            = general,
  scale     .usage:n            = general,
  unknown   .usage:n            = general,
  command   .groups:n           = config,
  fea       .groups:n           = config,
  features  .groups:n           = lateconfig,
  force     .groups:n           = config,
  scale     .groups:n           = config,
}
%    \end{macrocode}
% \end{keyname}
% \begin{keyname}{math/name,math/force,math/scale}
% Configure keys for Unicode maths.
%    \begin{macrocode}
\IfPackageLoadedF {unicode-math} {
  \keys_define:nn {lfc/math} {
    name      .code:n = { \use:c {_@@_set_math:n} {#1} },
    force     .code:n = { \keys_set:nn {lfc/fam} {force    = {#1}} },
    scale     .code:n = { \keys_set:nn {lfc/fam} {scale    = {#1}} },
    unknown   .code:n = {
      \exp_args:NnV \use:c {_@@_set_math:n} \l_keys_key_str
    },
    name      .value_required:n   = true,
    force     .default:n          = true,
    scale     .value_required:n   = true,
    unknown   .value_forbidden:n  = true,
    name      .usage:n            = preamble,
    force     .usage:n            = preamble,
    scale     .usage:n            = preamble,
    unknown   .usage:n            = preamble,
    force     .groups:n           = config,
    scale     .groups:n           = config,
  }
}
%    \end{macrocode}
% \end{keyname}
% \begin{keyname}{features/alternates,
%   features/embolden,
%   features/figures,
%   features/forms,
%   features/language,
%   features/ligatures,
%   features/mode,
%   features/script,
%   features/spacing,
% }
% \changes{v0.0}{2026-10-29}{Initial \texttt{features} keys: \texttt{alternates}, \texttt{embolden}, \texttt{figures}, \texttt{forms}, \texttt{language}, \texttt{ligatures}, \texttt{node}, \texttt{script}, \texttt{spacing}.}
% Trying to be a more user-friendly wrapper around \texttt{fam/fea}.
%    \begin{macrocode}
\keys_define:nn {lfc/features} {
  alt/annotation  .code:n = {
    \seq_put_right:Ne \l_@@_features_seq { nalt=#1}
  },
  alt/charactervariant .code:n = {
    \_@@_cvnn_aux:w #1 \q_stop
  },
  alt/stylistic   .code:n = {
    \seq_put_right:Ne \l_@@_features_seq {salt=#1}
  },
  alt/sset    .code:n = {
    \seq_put_right:Ne \l_@@_features_seq {
      +ss
      \int_compare:nNnT { 
        \tl_count:e { \tl_trim_spaces:n {#1} }
      } = {1} {0}
      #1
    }
  },
  alternates  .code:n = {
    \keys_set_known:nnN {lfc/features/alt} {#1} \l_@@_tmpb_tl
    \_@@_features_aux:Vn \l_@@_tmpb_tl {
      {contextual}      {+calt}
      {nocontextual}    {-calt}
      {contextualswash} {+cswh}
      {linefinal}       {+falt}
      {wordfinal}       {+fina}
      {justification}   {+jalt}
      %% The spec suggests this should take a number, but fontspec does it
      %% like this.
      {swash}           {+swsh}
    }
  },
  embolden    .code:n = {
    \seq_put_right:Nn \l_@@_features_seq {embolden=#1}
  },
  figures     .code:n = {
    \_@@_features_aux:nn {#1} {
      {lining}        {+lnum}
      {oldstyle}      {+onum}
      {osf}           {+onum}
      {prop}          {+pnum}
      {proportional}  {+pnum}
      {tab}           {+tnum}
      {tabular}       {+tnum}
      {zero}          {+zero}
    }
  },
  forms         .code:n = {
    \_@@_features_aux:nn {#1} {
      {case}          {+case}
      {nocase}        {-case}
      {capstopetite}  {+c2pc}
      {capstosc}      {+c2sc}
      {hist}          {+hist}
      {historical}    {+hist}
      {smalltopetite} {+pcap}
      {random}        {+rand}
      {titling}       {+titl}
      {unicase}       {+unic}
    }
  },
  language      .code:n = {
    \seq_put_right:Nn \l_@@_features_seq {language=#1}
  },
  ligatures     .code:n = {
    \_@@_features_aux:nn {#1} {
      {contextual}    {+clig}
      {nocontextual}  {-clig}
      {discretionary} {+dlig}
      {hist}          {+hlig}
      {historic}      {+hlig}
      {required}      {+rlig}
      {norequired}    {-rlig}
      {standard}      {+liga}
      {nostandard}    {-liga}
      {tex}           {+tlig}
      {notex}         {-tlig}
    } \l_@@_tmpa_tl
  },
  mode          .choices:nn = {base,node,harf}{
    \seq_put_right:Ne \l_@@_features_seq {mode=\l_keys_choice_str}
  },
  script        .code:n = {
    \seq_put_right:Nn \l_@@_features_seq {script=#1}
  },
  spacing       .code:n = {
    \_@@_features_aux:nn {#1} {
      {capsspacing}   {+cpsp}
      {kern}          {+kern}
      {nokern}        {-kern}
    }
  },
  alternates  .value_required:n = true,
  embolden    .value_required:n = true,
  figures     .value_required:n = true,
  forms       .value_required:n = true,
  language    .value_required:n = true,
  ligatures   .value_required:n = true,
  mode        .value_required:n = true,
  script      .value_required:n = true,
  spacing     .value_required:n = true,
}
%    \end{macrocode}
