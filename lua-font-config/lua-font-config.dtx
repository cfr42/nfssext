% \begin{macro}{\newfontset}%% ^^A <<<
%   \changes{v0.0}{2026-11-13}{New macro to define a new font set.}
%    \begin{macrocode}
\NewDocumentCommand\newfontset { o m } {
  \str_if_eq:eeTF {default} {#2} {
    \msg_warning:nn {lfc} {meta-fam-default-name}
  } {
    \cs_if_exist:NF \__@@_font_set_default:  {
      \msg_error:nn {lfc} {meta-fam-no-default}
    }
    \bool_if:NF \g_@@_lum_done_bool {
      \IfPackageLoadedTF {unicode-math} {
        \msg_error:nnn {lfc} {math-needs-lum} {font~sets}
      } {
        \msg_info:nnn {lfc} {loading} {lua-unicode-math} 
        \RequirePackage{lua-unicode-math}
        \bool_gset_true:N \g_@@_lum_done_bool
      }
    }
    \cs_if_free:cTF { __@@_font_set_#2: } {
      \tl_if_novalue:nTF {#1} {
        \__@@_new_font_set:n {#2}
      } {
        \cs_if_free:cTF { __@@_font_set_#1: } {
          \msg_error:nnnn {lfc} {base-set-not-configured} {#1} {#2}
        } {
          \__@@_new_font_set:nn {#1} {#2}
        }
      }
    } {
      \msg_error:nnn {lfc} {meta-fam-exists} {#2}
    }
  }
}
%    \end{macrocode}
