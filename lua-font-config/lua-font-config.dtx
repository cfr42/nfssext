\cs_new_protected_nopar:Npn \_@@_set_mathrm: {
  \SetMathAlphabet      \mathrm {normal} {TU} {lmr-base}  {m}   {n}
  \SetMathAlphabet      \mathit {normal} {TU} {lmr-base}  {m}   {it}
  \SetMathAlphabet      \mathbf {normal} {TU} {lmr-base}  {bx}  {n}
  \SetMathAlphabet      \mathrm {bold}   {TU} {lmr-base}  {bx}  {n}
  \SetMathAlphabet      \mathit {bold}   {TU} {lmr-base}  {bx}  {it}
  \SetMathAlphabet      \mathbf {bold}   {TU} {lmr-base}  {bx}  {n}
  \DeclareSymbolFont{operators}          {TU} {lmr-base}  {m}   {n}
  \SetSymbolFont    {operators} {bold}   {TU} {lmr-base}  {bx}  {n}
}
