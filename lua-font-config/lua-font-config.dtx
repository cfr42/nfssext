% \begin{keyname}{rm,sf,tt}%% ^^A <<<
%   Top-level keys for default text families.
%    \begin{macrocode}
\clist_map_inline:nn {rm, sf, tt} {
  \keys_define:nn {lfc} {
    #1 .code:n            = { 
      \tl_clear:N \l_@@_tmpa_tl
      \tl_clear:N \l_@@_tmpb_tl
      \keys_set_exclude_groups:nnnN {lfc/#1} {config} {##1} \l_@@_tmpa_tl
      \keys_set_groups:nnVN {lfc/#1} {config}     \l_@@_tmpa_tl \l_@@_tmpb_tl
      \keys_set_groups:nnV  {lfc/#1} {lateconfig} \l_@@_tmpb_tl
      \bool_set_true:N \l_@@_do_bool
    },
    #1 .value_required:n  = true,
    #1 .usage:n           = preamble,
  }
%    \end{macrocode}
% \end{keyname}%% ^^A >>>
%   \changes{v0.0}{2026-11-07}{Add keys to configure bold and regular series for default families and to enable use of fake bold and oblique.}
%   \changes{v0.0}{2026-11-10}{Add key to disable hyphenation character.}
% \begin{keyname}{.../name,.../bfseries,.../bold,.../mdseries,.../normal,.../fakebold,.../fakeoblique,.../fea,.../force,.../scale,.../scoped,.../maths,.../math,.../nomaths,.../nomath,.../hyphenchar}%% ^^A <<<
%   Configure keys for default text families.
%   Most of these just forward their values to \texttt{lfc/fam}.
%    \begin{macrocode}
  \keys_define:nn {lfc/#1} {
    name        .code:n   = { \use:c {__@@_set_#1:n} {##1} },
    bfseries    .code:n   = {
      \__@@_parse_series:nn {bfseries} {##1}
    },
    bold        .code:n   = {
      \str_set_eq:NN \l_@@_weight_str \c_empty_str
      \str_set_eq:NN \l_@@_width_str \c_empty_str
      \keys_set:nn {lfc/#1/series} {##1}
      \__@@_parse_series:nVV {bfseries} \l_@@_weight_str \l_@@_width_str
    },
    mdseries    .code:n   = {
      \__@@_parse_series:nn {mdseries} {##1}
    },
    normal      .code:n   = {
      \str_set_eq:NN \l_@@_weight_str \c_empty_str
      \str_set_eq:NN \l_@@_width_str \c_empty_str
      \keys_set:nn {lfc/#1/series} {##1}
      \__@@_parse_series:nVV {mdseries} \l_@@_weight_str \l_@@_width_str
    },
    series / weight .str_set:N = \l_@@_weight_str,
    series / width  .str_set:N = \l_@@_width_str,
    fakebold    .code:n   = { \keys_set:nn {lfc/fam} {fakebold    = {##1}} },
    fakeoblique .code:n   = { \keys_set:nn {lfc/fam} {fakeoblique = {##1}} },
    fea         .code:n   = { \keys_set:nn {lfc/fam} {fea         = {##1}} },
    features    .code:n   = { \keys_set:nn {lfc/fam} {features    = {##1}} },
    force       .code:n   = { \keys_set:nn {lfc/fam} {force       = {##1}} },
    hyphenchar  .code:n   = { \keys_set:nn {lfc/fam} {hyphenchar  = {##1}} },
    scale       .code:n   = { \keys_set:nn {lfc/fam} {scale       = {##1}} },
    scoped      .code:n   = { \keys_set:nn {lfc/fam} {scoped      =  ##1}  },
    maths       .code:n   = { \__@@_set_fam_cfg:nn   {maths}{##1} },
    math        .meta:n   = { maths = {##1} },
    nomaths     .meta:n   = { maths = false },
    nomath      .meta:n   = { nomaths },
    unknown     .code:n   = {
      \exp_args:NnV \use:c {__@@_set_#1:n} \l_keys_key_str
    },
    name          .value_required:n   = true,
    math          .default:n          = true,
    maths         .default:n          = true,
    nomath        .value_forbidden:n  = true,
    nomaths       .value_forbidden:n  = true,
    unknown       .value_forbidden:n  = true,
    fea           .groups:n           = config,
    features      .groups:n           = lateconfig,
    force         .groups:n           = config,
    hyphenchar    .groups:n           = config,
    maths         .groups:n           = config,
    math          .groups:n           = config,
    nomath        .groups:n           = config,
    nomaths       .groups:n           = config,
    scale         .groups:n           = config,
    scoped        .groups:n           = config,
  }
}
%    \end{macrocode}
% \end{keyname}%% ^^A >>>
%   \changes{v0.2}{2026-10-29}{Adjusted to support addition of \texttt{features} interface.}
% \begin{keyname}{debug,math}%% ^^A <<<
% \begin{keyname}{family}%% ^^A <<<
%   Top-level keys for additional families, Unicode maths and debugging.
%    \begin{macrocode}
\keys_define:nn {lfc} {
  debug   .code:n           = { 
    \tl_clear:N \l_@@_tmpa_tl
    \keys_set_groups:nnnN
      {lfc/debug} {toggle} {state = true, #1} \l_@@_tmpa_tl
    \keys_set:nV {lfc/debug} \l_@@_tmpa_tl
  },
  debug   .usage:n          = general,
  family  .code:n           = { 
    \tl_clear:N \l_@@_tmpa_tl
    \tl_clear:N \l_@@_tmpb_tl
    \str_clear:N \l_@@_scope_str
    \keys_set_exclude_groups:nnnN 
                          {lfc/fam} {config,lateconfig} {#1} \l_@@_tmpa_tl
    \keys_set_groups:nnVN {lfc/fam} {config}      \l_@@_tmpa_tl \l_@@_tmpb_tl
    \keys_set_groups:nnV  {lfc/fam} {lateconfig}  \l_@@_tmpb_tl
    \bool_set_true:N \l_@@_do_bool
  },
  family  .value_required:n = true,
  family  .usage:n          = general,
  math    .code:n           = { 
    \bool_if:NF \g_@@_lum_done_bool {
      \IfPackageLoadedTF {unicode-math} {
        \msg_error:nnn {lfc} {math-needs-lum} {math~config}
      } {
        \msg_info:nnn {lfc} {loading} {lua-unicode-math} 
        \RequirePackage{lua-unicode-math}
        \bool_gset_true:N \g_@@_lum_done_bool
      }
    }
    \tl_clear:N \l_@@_tmpa_tl
    \keys_set_exclude_groups:nnnN {lfc/math} {config} {#1} \l_@@_tmpa_tl
    \keys_set:nV {lfc/math} \l_@@_tmpa_tl
    \bool_set_true:N \l_@@_do_bool
  },
  math    .value_required:n = true,
  math    .usage:n          = preamble,
}
%    \end{macrocode}
