% \begin{variable}{\l_@@_tmpa_tl,\l_@@_tmpa_bool}
%   Custom ephemeral variables.
%    \begin{macrocode}
\tl_new:N \l_@@_tmpa_tl
\bool_new:N \l_@@_tmpa_bool
%    \end{macrocode}
% \end{variable}
% \begin{keyname}{rm,sf,tt}
% Top-level keys for default text families.
%    \begin{macrocode}
\clist_map_inline:nn {rm, sf, tt} {
  \keys_define:nn {lfc} {
    #1 .code:n            = { 
      \keys_set_exclude_groups:nnnN {lfc/#1} {config} {##1} \l_@@_tmpa_tl
      \keys_set:nV {lfc/#1} \l_@@_tmpa_tl
      \bool_set_true:N \l_@@_tmpa_bool
    },
    #1 .value_required:n  = true,
    #1 .usage:n           = preamble,
  }
%    \end{macrocode}
% \begin{keyname}{name,fea,force,scale,maths,math,nomaths,nomath}
% Configure keys for default text families.
%    \begin{macrocode}
  \keys_define:nn {lfc/#1} {
    name      .code:n = { \use:c {_@@_set_#1:n} {##1} },
    fea       .code:n = { \keys_set:nn {lfc/fam} {fea      = {##1}} },
    force     .code:n = { \keys_set:nn {lfc/fam} {force    = {##1}} },
    scale     .code:n = { \keys_set:nn {lfc/fam} {scale    = {##1}} },
    maths     .code:n = { \_@@_set_fam_cfg:nn   {maths}{##1} },
    math      .meta:n = { maths = {##1} },
    nomaths   .meta:n = { maths = false },
    nomath    .meta:n = { nomaths },
    unknown   .code:n = {
      \exp_args:NnV \use:c {__@@_set_#1:n} \l_keys_key_str
    },
    name      .value_required:n   = true,
    math      .default:n          = true,
    maths     .default:n          = true,
    nomath    .value_forbidden:n  = true,
    nomaths   .value_forbidden:n  = true,
    unknown   .value_forbidden:n  = true,
    fea       .groups:n           = config,
    force     .groups:n           = config,
    maths     .groups:n           = config,
    math      .groups:n           = config,
    nomath    .groups:n           = config,
    nomaths   .groups:n           = config,
    scale     .groups:n           = config,
  }
}
%    \end{macrocode}
% \end{keyname}
% \end{keyname}
% \begin{keyname}{debug,family,math}
% Top-level keys for additional families, Unicode maths and debugging.
%    \begin{macrocode}
\keys_define:nn {lfc} {
  debug   .code:n           = { 
    \keys_set:nn {lfc/debug} {
      state       = true,
      categories  = {"doc"},
      #1
    } 
  },
  debug   .usage:n          = general,
  family  .code:n           = { 
    \keys_set_exclude_groups:nnnN {lfc/fam} {config} {#1} \l_@@_tmpa_tl
    \keys_set:nV {lfc/fam} \l_@@_tmpa_tl
    \bool_set_true:N \l_@@_tmpa_bool
  },
  family  .value_required:n = true,
  family  .usage:n          = general,
  math    .code:n           = { 
    \IfPackageLoadedTF {unicode-math} {
      \msg_error:nn {lfc} {math-needs-lum}
    } {
      \msg_info:nnn {lfc} {loading} {lua-unicode-math} 
      \RequirePackage{lua-unicode-math}
      \keys_set_exclude_groups:nnnN {lfc/math} {config} {#1} \l_@@_tmpa_tl
      \keys_set:nV {lfc/math} \l_@@_tmpa_tl
      \bool_set_true:N \l_@@_tmpa_bool
    }
  },
  math    .value_required:n = true,
  math    .usage:n          = preamble,
}
%    \end{macrocode}
% \end{keyname}
% \begin{keyname}{name,fea,force,scale}
% Configure keys for families.
%    \begin{macrocode}
\keys_define:nn {lfc/fam} {
  name      .code:n = { \__@@_set_fam_name:n {#1} },
  fea       .code:n = { \__@@_set_fam_cfg:nn {fea}{#1} },
  force     .code:n = { \__@@_set_fam_cfg:nn {force}{#1} },
  scale     .code:n = { \__@@_set_fam_cfg:nn {scale}{#1} },
  unknown   .code:n = {
    \exp_args:NV \__@@_set_fam_name:n \l_keys_key_str 
  },
  name      .value_required:n   = true,
  fea       .value_required:n   = true,
  force     .default:n          = true,
  scale     .value_required:n   = true,
  unknown   .value_forbidden:n  = true,
  name      .usage:n            = general,
  fea       .usage:n            = general,
  force     .usage:n            = general,
  scale     .usage:n            = general,
  unknown   .usage:n            = general,
  fea       .groups:n           = config,
  force     .groups:n           = config,
  scale     .groups:n           = config,
}
%    \end{macrocode}
% \end{keyname}
% \begin{keyname}{name,force,scale}
% Configure keys for Unicode maths.
%    \begin{macrocode}
\IfPackageLoadedF {unicode-math} {
  \keys_define:nn {lfc/math} {
    name      .code:n = { \use:c {_@@_set_math:n} {#1} },
    force     .code:n = { \keys_set:nn {lfc/fam} {force    = {#1}} },
    scale     .code:n = { \keys_set:nn {lfc/fam} {scale    = {#1}} },
    unknown   .code:n = {
      \exp_args:NnV \use:c {_@@_set_math:n} \l_keys_key_str
    },
    name      .value_required:n   = true,
    force     .default:n          = true,
    scale     .value_required:n   = true,
    unknown   .value_forbidden:n  = true,
    name      .usage:n            = preamble,
    force     .usage:n            = preamble,
    scale     .usage:n            = preamble,
    unknown   .usage:n            = preamble,
    force     .groups:n           = config,
    scale     .groups:n           = config,
  }
}
%    \end{macrocode}
% \end{keyname}
% \begin{keyname}{state,categories}
% Configure keys for debugging.
%    \begin{macrocode}
\keys_define:nn {lfc/debug} {
  state       .choice:,
  state/false .code:n             = { \_@@_debug_set_false: },
  state/true  .code:n             = { \_@@_debug_set_true: },
  categories  .code:n             = { \_@@_debug_set_cats:n {#1} },
  state       .default:n          = true,
  state       .usage:n            = general,
  categories  .value_required:n   = true,
  categories  .usage:n            = general,
}
%    \end{macrocode}
% \end{keyname}
% \begin{macro}{\fontconfig}
%   The main (and currently(?) only) public macro.
%    \begin{macrocode}
\NewDocumentCommand\fontconfig { +m }{
  \bool_set_false:N \l_@@_tmpa_bool
  \keys_set:nn {lfc} {#1}
  \bool_if:NT \l_@@_tmpa_bool {
    \_@@_configure_doc_families:
  }
}
%    \end{macrocode}
% \end{macro}
% \begin{function}{\_@@_set_mathrm:,\_@@_set_mathsf:,\_@@_set_mathtt:}
% TODO: move to hooks if module gets support for switching the families out e.g.~for language changes.
% Currently, the code is too simple-minded for this to arise \dots.
%    \begin{macrocode}
\cs_new_protected_nopar:Npn \_@@_set_mathrm: {
  \SetMathAlphabet \mathrm {normal} {TU} \rmdefault {\mdseries@rm} \shapedefault
  \SetMathAlphabet \mathit {normal} {TU} \rmdefault {\mdseries@rm} \itdefault
  \SetMathAlphabet \mathbf {normal} {TU} \rmdefault {\bfseries@rm} \shapedefault
  \SetMathAlphabet \mathrm {bold}   {TU} \rmdefault {\bfseries@rm} \shapedefault
  \SetMathAlphabet \mathit {bold}   {TU} \rmdefault {\bfseries@rm} \itdefault
  \SetMathAlphabet \mathbf {bold}   {TU} \rmdefault {\bfseries@rm} \shapedefault
  \SetSymbolFont{operators}{normal} {TU} \rmdefault {\mdseries@rm} \shapedefault
  \SetSymbolFont{operators}{bold}   {TU} \rmdefault {\bfseries@rm} \shapedefault
}
\cs_new_protected_nopar:Npn \_@@_set_mathsf: {
  \SetMathAlphabet \mathsf {normal} {TU} \sfdefault {\mdseries@sf} \shapedefault
  \SetMathAlphabet \mathsf {bold}   {TU} \sfdefault {\bfseries@sf} \shapedefault
}
\cs_new_protected_nopar:Npn \_@@_set_mathtt: {
  \SetMathAlphabet \mathtt {normal} {TU} \ttdefault {\mdseries@tt} \shapedefault
  \SetMathAlphabet \mathtt {bold}   {TU} \ttdefault {\bfseries@tt} \shapedefault
}
%    \end{macrocode}
% \end{function}
% \begin{function}{\_@@_declare_lum_symbol_fonts:nn}
%    \begin{macrocode}
\cs_new_protected_nopar:Npn \_@@_declare_lum_symbol_fonts:nn #1#2 {
  \DeclareSymbolFont{lummain}{TU}{#1}{m}{n}
  \SetSymbolFont{lummain}{bold}{TU}{#2}{b}{n}
}
%    \end{macrocode}
% \end{function}
% This should be equivalent to the default setup, modulo any differences between loading the package and using \cs{setmathfont} for \pkg{lua-unicode-math}.
%    \begin{macrocode}
\hook_gput_code:nnn {class/ltx-talk/before} {.} {
  \hook_gput_code:nnn {package/mathtools/after} {.} {
    \RequirePackage{lua-unicode-math}
    \fontconfig{
      rm      = {newcomputermodernsans},
      sf      = {newcomputermodernsans},
      math    = {newcomputermodernsansmath},
    }
    \tagpdfsetup { math / mathml / luamml / load = true }
  }
}
\lua_load_module:n {lua-font-config}
\ExplSyntaxOff
