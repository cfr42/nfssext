\documentclass{article}
\usepackage{lua-font-config}
\fontconfig{%
  rm = {%
    name = TeX Gyre Pagella,
    features = {figures = {oldstyle,proportional},},
  },
  sf = {% We could omit lining here as it is the default for these fonts.
    name = TeX Gyre Heros,
    features = {figures = {lining,proportional},},
  },
  tt = {% Avoid ligatures in code listings etc.
    name = TeX Gyre Cursor,
    features = {figures = {lining,tabular}, ligatures = {nocommon,notex},},
  },
  math = TeX Gyre Pagella Math,
}
\newfontset{latinii}% Create a new font set named ‘latinii’.
\fontconfig[latinii]{% Configure our alternative font set.
  rm = {% We use lining, rather than oldstyle, figures for this set.
    name = TeX Gyre Schola,
    features = {figures = proportional},
  },
  sf = {%
    name = TeX Gyre Adventor,
    features = {figures = proportional},
  },
  tt = {% We repeat our typewriter setup - w/o this, we'd get lmtt.
    name = TeX Gyre Cursor,
    features = {figures = {lining,tabular}, ligatures = {nocommon,notex},},
  },
  math = TeX Gyre Schola Math,
}
\newcommand*\testme{Oh, sphinx of black quartz, hear my vow! -- 0123456789 --- Infinity\par}
\newcommand*\testma{%
  $\mathrm{ABC abc} \mathbf{Abc abc} \mathit{Abc abc} \mathsf{Abc abc} \mathtt{Abc abc} \sin\theta \mathscr{ABC}$\par
  $v = ut + \frac{1}{2}at^2$\par
}
\begin{document}
% Default font set
\rmfamily \testme
\sffamily \testme
\ttfamily \testme
\normalfont \testma

% Switch to ‘latinii’ font set
\usefontset{latinii}
\rmfamily \testme
\sffamily \testme
\ttfamily \testme
\normalfont \testma

% Restore default font set
\usefontset{default}
\rmfamily \testme
\sffamily \testme
\ttfamily \testme
\normalfont \testma
\end{document}

