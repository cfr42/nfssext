% \begin{function}{\_@@_cvnn_aux:w}
%   Parser for \texttt{cv}\meta{digit}\meta{digit} substitutions.
%   \changes{v0.0}{2026-10-29}{Added.}
%   Should we do more checks here?
%    \begin{macrocode}
\cs_new_nopar:Npn \_@@_cvnn_aux:w #1:#2 \q_stop {
  \seq_put_right:Ne \l_@@_features_seq {
    cv
    \int_compare:nNnT { 
      \tl_count:e { \tl_trim_spaces:n {#1} }
    } = {1} {0}
    #1=#2;
  }
}
%    \end{macrocode}
% \end{function}
% \begin{function}{\_@@_features_aux:nn,\_@@_features_aux:Vn}
%   Parser for valueless \texttt{lfc/features} keys.
%   \changes{v0.0}{2026-10-29}{Added.}
%    \begin{macrocode}
\cs_new_nopar:Npn \_@@_features_aux:nn #1#2 {
  \clist_map_inline:nn {#1} {
    \tl_if_blank:nF { \tl_trim_spaces:n {##1} } {
      \seq_put_right:Ne \l_@@_features_seq {
        \str_case:nnF {##1} {
          #2
        } {##1}
      }
    }
  }
}
\cs_generate_variant:Nn \_@@_features_aux:nn {V}
%    \end{macrocode}
% \end{function}
