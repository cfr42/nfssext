% \changes{v0.0}{2026-11-24}{Addition of disposable variants \dots.}
% \begin{function}{\_@@_set_mathrm:n,\_@@_set_mathsf:n,\_@@_set_mathtt:n,
%   \_@@_set_mathrm:,\_@@_set_mathsf:,\_@@_set_mathtt:,
%   \_@@_set_mathrm:nnnnnn,\_@@_set_mathsf:nnnnn,\_@@_set_mathtt:nnnnn,
%   \_@@_set_mathrm:nnVVVV,\_@@_set_mathsf:nnVVV,\_@@_set_mathtt:nnVVV}%% ^^A <<<
%   These are set up slightly differently for \texttt{default} and non-default \fontsettarg*.
%    \begin{macrocode}
\cs_new_protected_nopar:Npn \_@@_set_mathrm:nnnnnn #1#2#3#4#5#6 {
%<debug>      \msg_log:nnnn {lfc} {info} {
%<debug>        Configuring~math~versions~normal@#1~and~bold@#1
%<debug>      } {
%<debug>        \token_to_str:N \mathrm ~->~ #2,~#3,~#5.~
%<debug>        \token_to_str:N \mathit ~->~ #2,~#3,~#6.~
%<debug>        \token_to_str:N \mathbf ~->~ #2,~#4,~#5.~
%<debug>        oerators ~->~ #2,~#3,~#5.~
%<debug>        and~
%<debug>        \token_to_str:N \mathrm ~->~ #2,~#4,~#6.~
%<debug>        \token_to_str:N \mathit ~->~ #2,~#4,~#6.~
%<debug>        \token_to_str:N \mathbf ~->~ #2,~#3,~#5.~
%<debug>        oerators ~->~ #2,~#4,~#5.~
%<debug>      }
  \tl_if_blank:nTF {#1} {
    \SetMathAlphabet \mathrm {normal} {TU} {#2} {#3} {#5}
    \SetMathAlphabet \mathit {normal} {TU} {#2} {#3} {#6}
    \SetMathAlphabet \mathbf {normal} {TU} {#2} {#4} {#5}
    \SetMathAlphabet \mathrm {bold}   {TU} {#2} {#4} {#5}
    \SetMathAlphabet \mathit {bold}   {TU} {#2} {#4} {#6}
    \SetMathAlphabet \mathbf {bold}   {TU} {#2} {#4} {#5}
    \SetSymbolFont{operators}{normal} {TU} {#2} {#3} {#5}
    \SetSymbolFont{operators}{bold}   {TU} {#2} {#4} {#5}
    \cs_gset_protected_nopar:Npn \_@@_set_mathrm: {}
  } {
    \SetMathAlphabet \mathrm {normal@#1} {TU} {#2} {#3} {#5}
    \SetMathAlphabet \mathit {normal@#1} {TU} {#2} {#3} {#6}
    \SetMathAlphabet \mathbf {normal@#1} {TU} {#2} {#4} {#5}
    \SetMathAlphabet \mathrm {bold@#1}   {TU} {#2} {#4} {#5}
    \SetMathAlphabet \mathit {bold@#1}   {TU} {#2} {#4} {#6}
    \SetMathAlphabet \mathbf {bold@#1}   {TU} {#2} {#4} {#5}
    \SetSymbolFont{operators}{normal@#1} {TU} {#2} {#3} {#5}
    \SetSymbolFont{operators}{bold@#1}   {TU} {#2} {#4} {#5}
  }
}
\cs_new_protected_nopar:Npn \_@@_set_mathsf:nnnnn #1#2#3#4#5 {
%<debug>      \msg_log:nnnn {lfc} {info} {
%<debug>        Configuring~math~versions~normal@#1~and~bold@#1
%<debug>      } {
%<debug>        \mathsf ~->~ #2,~#3,~#5.~
%<debug>        and~
%<debug>        \mathsf ~->~ #2,~#4,~#5.
%<debug>      }
  \tl_if_blank:nTF {#1} {
    \SetMathAlphabet \mathsf {normal} {TU} {#2} {#3} {#5}
    \SetMathAlphabet \mathsf {bold}   {TU} {#2} {#4} {#5}
    \cs_gset_protected_nopar:Npn \_@@_set_mathsf: {}
  } {
    \SetMathAlphabet \mathsf {normal@#1} {TU} {#2} {#3} {#5}
    \SetMathAlphabet \mathsf {bold@#1}   {TU} {#2} {#4} {#5}
  }
}
\cs_new_protected_nopar:Npn \_@@_set_mathtt:nnnnn #1#2#3#4#5 {
%<debug>      \msg_log:nnnn {lfc} {info} {
%<debug>        Configuring~math~versions~normal@#1~and~bold@#1
%<debug>      } {
%<debug>        \mathtt ~->~ #2,~#3,~#5.~
%<debug>        and~
%<debug>        \mathtt ~->~ #2,~#4,~#5.
%<debug>      }
  \tl_if_blank:nTF {#1} {
    \SetMathAlphabet \mathtt {normal} {TU} {#2} {#3} {#5}
    \SetMathAlphabet \mathtt {bold}   {TU} {#2} {#4} {#5}
    \cs_gset_protected_nopar:Npn \_@@_set_mathtt: {}
