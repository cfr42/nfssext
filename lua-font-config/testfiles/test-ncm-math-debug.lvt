\input lfc-support.tex
\documentclass{article}
\directlua {
  function print(...)
    local t = {...}
    for _,i in ipairs(t) do
      texio.write_nl(tostring(i))
    end
  end
}
\START
\usepackage{lua-font-config}
\fontconfig{%
  debug = {
    categories = {cache, callback, defn, doc},
  },
  rm = newcomputermodern,
  sf = newcomputermodernsans,
  tt = newcomputermodernmono,
  math = newcomputermodernmath,
}
\parindent=0pt
\begin{document}
\[
    \sin\theta^2 + \cos\theta^2 = 1
\]
$\mathsf{x} \mathtt{x} \mathbf{x}$

\mathversion{bold}
\[
    \sin\theta^2 + \cos\theta^2 = 1
\]
$\mathsf{x} \mathtt{x} \mathbf{x}$
\end{document}
