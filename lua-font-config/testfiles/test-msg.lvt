\input lfc-support.tex
\makeatletter
\csname protected\endcsname\long\def\TESTTITLE#1{%
  \global\advance\gTESTint by 1 %
  \SEPARATOR
  \LONGTYPEOUT{TEST \the\gTESTint: \detokenize{#1}}%
  \SEPARATOR
}
\makeatother
\documentclass{article}
\parindent=0pt
\START
\usepackage{lua-font-config}
\SEPARATOR
\TESTTITLE{debug + config}
\fontconfig{%
  debug = {
    categories = {defn, doc, cache}, 
  },
  family = {%
    name = Lobster Two,
    scale = 5,
    command = \lobstertwo,
  },
}
\OMIT
\begin{document}
\TIMO
\TEST{debug + scaling}{%
  {\lobstertwo Lobster Two}%
}
\END
\end{document}

