\input lfc-support.tex
\documentclass{article}
\parindent=0pt
\START
\usepackage{lua-font-config}
\fontconfig{%
  family={%
    name = imfellenglish,
    command = \imfell,
  },
  family = {%
    name = imfellenglish,
    command = \imfellbf,
    fea = {embolden=10},
  },
}
\begin{document}
\OMIT
\fontsize{13.5}{15}%
\TIMO
\TEST{family default macro}{%
  \imfell
  This is standard IM FELL English Roman

  \itshape
  This is standard IM FELL English Italic
}
\OMIT
\normalfont
\TIMO
\TEST{family variant macro}{%
  \imfellbf
  This is standard IM FELL English Roman

  \itshape
  This is standard IM FELL English Italic
}
\END

\end{document}
