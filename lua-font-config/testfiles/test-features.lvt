%% $Id: test-features.lvt 12169 2026-10-30 03:26:38Z cfrees $
\input lfc-support.tex
\documentclass{article}
\parindent=0pt
\usepackage{lua-font-config}
\fontconfig{%
  rm = {%
    name = TeX Gyre Pagella,
    features = {%
      mode=node,
      script=dflt,
      language=dflt,
      ligatures={tex},
      figures={osf,prop},
    },
  },
  sf = {% 
    name = texgyreheros,
    features = {%
      mode=node,
      script=dflt,
      language=dflt,
      ligatures={tex},
      figures={lining,prop},
    },
  },
  tt = {% 
    name = texgyrecursor,
    features = {%
      mode=node,
      script=dflt,
      language=dflt,
      ligatures={notex,nostandard},
      figures={lining,tab},
    },
  },
  family={%
    name = imfellenglish,
    command = \imfell,
  },
  family = {%
    name = imfellenglish,
    command = \imfellbf,
    features = {embolden=10},
  },
}
\begin{document}
\START
\OMIT
\fontfamily{lmr}\selectfont
\TIMO
\TEST{texgyrepagella osf prop}{%
  \normalfont
  \TeX-Gyre Pagella: 0123456789
}

\TEST{texgyreheros prop lining}{%
  \sffamily
  \TeX-Gyre Heros: 0123456789
}

\TEST{texgyrecursor notex tab lining}{%
  \ttfamily
  \TeX-Gyre Cursor 0123456789
  -- --- outfitted officials affluently affiliate fish finials flagranty, first
  finalising infinite floral affinities of fish-filled fingers
}

\OMIT
\fontsize{13.5}{15}%
\TIMO
\TEST{family default macro}{%
  \imfell
  This is standard IM FELL English Roman

  \itshape
  This is standard IM FELL English Italic
}

\OMIT
\normalfont
\TIMO
\TEST{family variant macro}{%
  \imfellbf
  This is standard IM FELL English Roman

  \itshape
  This is standard IM FELL English Italic
}
\END

\end{document}
